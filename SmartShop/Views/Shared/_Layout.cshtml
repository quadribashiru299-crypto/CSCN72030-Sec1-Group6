<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartShop HMI</title>
    <style>
        :root {
            --bg: #0b1220;
            --panel: #131e33;
            --line: #233252;
            --text: #e6ecf7;
            --muted: #8ba0bf;
            --ok: #22c55e;
            --warn: #f59e0b;
            --crit: #ef4444;
            --dim: #5b6b85;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
        }
        header {
            border-bottom: 1px solid var(--line);
            padding: 14px 24px;
            display: flex;
            align-items: center;
            gap: 32px;
            background: #0e1729;
        }
        .brand { font-weight: 700; letter-spacing: .5px; }
        .brand span { color: var(--muted); font-weight: 400; }
        nav { display: flex; gap: 6px; }
        nav a {
            color: var(--muted);
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 14px;
        }
        nav a:hover { background: var(--panel); color: var(--text); }
        main { max-width: 1200px; margin: 0 auto; padding: 28px 24px 60px; }
        h1 { font-size: 22px; margin: 0 0 6px; }
        .sub { color: var(--muted); font-size: 14px; margin-bottom: 24px; }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }
        .card {
            background: var(--panel);
            border: 1px solid var(--line);
            border-left: 4px solid var(--dim);
            border-radius: 10px;
            padding: 16px 18px;
        }
        .card.normal { border-left-color: var(--ok); }
        .card.warning { border-left-color: var(--warn); }
        .card.critical { border-left-color: var(--crit); background: #2a1520; }
        .card.unavailable { opacity: .55; }
        .card h3 { font-size: 14px; margin: 0 0 10px; color: var(--muted); font-weight: 500; }
        .value {
            font-size: 32px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            line-height: 1.1;
        }
        .value .unit { font-size: 14px; color: var(--muted); font-weight: 400; margin-left: 4px; }
        .meta { margin-top: 10px; font-size: 12px; color: var(--muted); display: flex; justify-content: space-between; }
        .badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
        }
        .badge.normal { background: rgba(34,197,94,.15); color: var(--ok); }
        .badge.warning { background: rgba(245,158,11,.15); color: var(--warn); }
        .badge.critical { background: rgba(239,68,68,.2); color: var(--crit); }
        .badge.unavailable { background: rgba(91,107,133,.2); color: var(--muted); }
        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 20px 22px;
            margin-bottom: 20px;
        }
        .links { display: flex; gap: 12px; flex-wrap: wrap; }
        .links a {
            background: var(--panel);
            border: 1px solid var(--line);
            color: var(--text);
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 8px;
            font-size: 14px;
        }
        .links a:hover { border-color: var(--ok); }
        .note { color: var(--muted); font-size: 13px; line-height: 1.6; }
    </style>
</head>
<body>
    <header>
        <div class="brand">SmartShop <span>SCADA / HMI</span></div>
        <nav>
            <a asp-controller="Home" asp-action="Index">Overview</a>
            <a asp-controller="Home" asp-action="Staff">Staff Console</a>
            <a asp-controller="Home" asp-action="Customer">Customer View</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
